#include <stdio.h>
#include <stdlib.h>

int main() {
    int n;
    scanf("%d", &n);

    int *candles = (int *)malloc(n * sizeof(int));

    if (candles == NULL)
        return 1;

    int max = 0;
    int count = 0;

    for (int i = 0; i < n; i++) {
        scanf("%d", &candles[i]);

        if (candles[i] > max) {
            max = candles[i];
            count = 1;
        } else if (candles[i] == max) {
            count++;
        }
    }

    printf("%d\n", count);

    free(candles);
    return 0;
}
